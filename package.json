{
  "name": "zetaoffice-mcp",
  "version": "1.0.0",
  "description": "LibreOffice WebAssembly MCP server: documents, native Math and pictures with no desktop LibreOffice",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:headless": "node server.mjs --headless",
    "start:browser": "node server.mjs --browser",
    "mcp": "node mcp_stdio_server.mjs",
    "mcp:browser": "HEADLESS=false node mcp_stdio_server.mjs",
    "start:node": "node server.mjs --node"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "libreoffice",
    "zetajs",
    "zetaoffice",
    "wasm",
    "uno",
    "webassembly"
  ],
  "author": "ZetaOffice MCP contributors",
  "license": "MIT"
}
