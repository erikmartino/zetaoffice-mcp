{
  "name": "zetaoffice-mcp",
  "version": "1.2.0",
  "description": "LibreOffice WebAssembly MCP server: Writer/Calc/Impress editing with a high-level capability layer, no desktop LibreOffice",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:headless": "node server.mjs --headless",
    "start:browser": "node server.mjs --browser",
    "mcp": "node start.mjs",
    "mcp:browser": "HEADLESS=false node mcp_stdio_server.mjs",
    "start:node": "node server.mjs --node",
    "test": "node test_client.mjs",
    "test:layout": "node scripts/layout_smoke.mjs",
    "test:layout:mcp": "node scripts/layout_mcp_test.mjs",
    "test:lease": "node scripts/lease_smoke.mjs",
    "test:bench": "node scripts/bench_regression.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "keywords": [
    "mcp",
    "libreoffice",
    "zetajs",
    "zetaoffice",
    "wasm",
    "uno",
    "webassembly"
  ],
  "author": "ZetaOffice MCP contributors",
  "license": "MIT"
}
